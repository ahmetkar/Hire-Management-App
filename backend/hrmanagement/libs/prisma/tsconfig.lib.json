{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "generated/**/*.ts"
  ],
  "references": [
    {
      "path": "../metrics/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
